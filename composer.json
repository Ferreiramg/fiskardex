{
  "name": "fiskardex/mvp",
  "description": "MVP de ingestão e visualização de documentos fiscais.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-simplexml": "*",
    "symfony/http-foundation": "^7.3",
    "symfony/routing": "^7.3",
    "symfony/uid": "^7.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "Fiskardex\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Fiskardex\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": "php -S 127.0.0.1:8000 -t public public/index.php",
    "test": "phpunit",
    "lint": "phpcs --standard=PSR12 src tests public",
    "check": [
      "@lint",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
