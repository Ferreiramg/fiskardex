<?php

declare(strict_types=1);

use Fiskardex\Database\Migrator;

require dirname(__DIR__) . '/vendor/autoload.php';

$databasePath = getenv('APP_DATABASE_PATH') ?: dirname(__DIR__) . '/var/data/fiskardex.sqlite';
$directory = dirname($databasePath);

if (!is_dir($directory)) {
    mkdir($directory, 0775, true);
}

$connection = new PDO('sqlite:' . $databasePath);
$migrator = new Migrator($connection, dirname(__DIR__) . '/database/migrations');
$executed = $migrator->migrate();

printf("%d migration(s) executada(s).%s", $executed, PHP_EOL);
